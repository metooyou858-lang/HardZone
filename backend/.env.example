# Server
HOST=127.0.0.1
PORT=3000
APP_TIMEZONE=Asia/Vladivostok
APP_BASE_URL=http://localhost:3001
FRONTEND_BASE_URL=http://localhost:3001

# Database: use either DATABASE_URL or DB_* fields.
DATABASE_URL=postgres://hardzone:hardzone@127.0.0.1:5432/hardzone
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hardzone
DB_USER=hardzone
DB_PASSWORD=hardzone

# Shared auth/session secrets. Use strong unique values in production.
HARDZONE_SESSION_SECRET=change-me
BACKEND_API_TOKEN=change-me
AUTH_PROXY_SECRET=
AUTH_TOKEN=

# Bootstrap owner/admin user. Used by backend auth bootstrap logic.
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_NAME=Главный администратор
AUTH_BOOTSTRAP_ROLE=owner
AUTH_BOOTSTRAP_EMAIL=

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org/bot
TELEGRAM_RELAY_SECRET=

# AQSI
AQSI_BASE_URL=
AQSI_API_KEY=
AQSI_SHOP_ID=
AQSI_DEVICE_ID=
AQSI_SLIP_PRINT_COUNT=
AQSI_SLIP_TTL_MS=
AQSI_FAST_SYNC_INTERVAL_MS=30000
AQSI_SYNC_INTERVAL_MS=300000
AQSI_WEBHOOK_LOG_DIR=

# Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Logs
LOG_DIR=
