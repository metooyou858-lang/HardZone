# Backend API visible only to the Next.js server runtime.
BACKEND_API_URL=http://127.0.0.1:3000/api
INTERNAL_API_URL=http://127.0.0.1:3000/api

# Must match backend HARDZONE_SESSION_SECRET or BACKEND_API_TOKEN.
HARDZONE_SESSION_SECRET=change-me
BACKEND_API_TOKEN=change-me

# Local development usually uses false. Production behind HTTPS should use true.
SESSION_COOKIE_SECURE=false
